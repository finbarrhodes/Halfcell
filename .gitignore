# Data files (keep structure, ignore large data)
data/raw/*.csv
data/raw/*.json
data/raw/*.parquet
data/processed/*.csv
data/processed/*.json
# ... except the walk-forward fold metadata, which pairs with the committed
# prediction table: without it a fresh clone has forecasts but no per-fold
# metrics, and the backtester's fold chart falls back to its empty state.
!data/processed/forecast_walk_forward_folds.json
# Per-model benchmark prediction tables: regenerable, one per model tried
data/processed/benchmarks/
data/raw/*.pkl
data/processed/*.pkl

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Processed Parquet files ARE committed — pre-aggregated, ~5 MB total. Keep it that
# way. data/raw is ignored and exists only on the machine that collected it, so these
# are the only copy of the history a CI runner ever sees: refresh_data.yml extends
# them in place with `prepare_data.py --append`, and the site build reads them.
# Stop committing them and the monthly refresh has nothing to append to.
!data/processed/*.parquet

# Cache Parquet files ARE committed — pre-computed backtest results the site build
# reads directly. Computing them takes ~30 min, far too slow to do on every deploy.
# refresh_data.yml regenerates them monthly; locally: python scripts/precompute_cache.py

